{
	"$schema": "https://unpkg.com/knip@5/schema.json",
	"ignore": [".claude/**"],
	"ignoreExportsUsedInFile": {
		"interface": true,
		"type": true
	},
	"tags": ["-lintignore"],
	"ignoreDependencies": ["cloudflare"],
	"workspaces": {
		".": {
			"ignoreDependencies": ["@changesets/cli"]
		},
		"packages/pds": {
			"ignore": ["scripts/**", "test/fixtures/**", "e2e/fixture/**"],
			"ignoreDependencies": [
				"tsx",
				"vite",
				"@cloudflare/vite-plugin",
				"@atproto/common",
				"@atproto/common-web"
			]
		},
		"packages/spaces": {
			"ignore": ["test/fixtures/**"],
			"ignoreDependencies": [
				"wrangler",
				"@atproto/common",
				"@atproto/common-web"
			]
		},
		"packages/space-conformance": {
			"ignoreDependencies": [
				"@atproto/common",
				"@atproto/common-web",
				"@atproto/lexicon",
				"@atproto/oauth-client",
				"@atproto/xrpc"
			]
		},
		"apps/check": {
			"entry": ["src/worker.ts"]
		},
		"packages/create-pds": {
			"ignore": ["templates/**"]
		}
	}
}
