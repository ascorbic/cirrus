{
	"name": "@getcirrus/spaces",
	"version": "0.1.0",
	"description": "Atproto spaces engine (alpha) for Cloudflare Workers \u2013 permissioned repos, space hosting and credentials",
	"type": "module",
	"main": "dist/index.js",
	"files": [
		"dist"
	],
	"exports": {
		".": "./dist/index.js"
	},
	"scripts": {
