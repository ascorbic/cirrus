{
	// Test configuration for the PDS worker fixture
	"name": "pds-test",
	"main": "index.ts",
	"compatibility_date": "2025-12-02",
	"compatibility_flags": ["nodejs_compat"],
	"durable_objects": {
		"bindings": [
			{
				"name": "ACCOUNT",
				"class_name": "AccountDurableObject",
			},
			{
				"name": "SPACES",
				"class_name": "SpaceDurableObject",
			},
			{
				"name": "SPACES_INDEX",
				"class_name": "SpaceIndexDurableObject",
			},
		],
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["AccountDurableObject"],
		},
		{
			"tag": "v2",
			"new_sqlite_classes": ["SpaceDurableObject", "SpaceIndexDurableObject"],
		},
	],
	"r2_buckets": [
		{
			"binding": "BLOBS",
			"bucket_name": "test-blobs",
		},
	],
}
